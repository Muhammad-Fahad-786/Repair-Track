# Application
APP_NAME=RepairTrack API
APP_VERSION=0.1.0
ENVIRONMENT=development

# CORS — URL of the Vite dev server
FRONTEND_URL=http://localhost:5173

# Optional — comma-separated list of additional allowed origins
# EXTRA_CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Database — SQLite for development
DATABASE_URL=sqlite:///./repairtrack.db

# JWT — generate a strong random key for production
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-real-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Phase 5.8 -- AI Repair Assistance (Google Gemini)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI analysis without errors.
# NEVER commit a real API key to version control.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
